<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext (HTTP) traffic is blocked by default on Android 9+ (API 28).
  The indoor 360° viewer serves its Pannellum page and panorama images from
  an on-device InAppLocalhostServer over http://localhost:8459 (see
  lib/features/scan/presentation/widgets/indoor_webview.dart). Without this
  scoped exception the WebView fails with net::ERR_CLEARTEXT_NOT_PERMITTED and
  the viewer renders "Webpage not available".

  This permits cleartext ONLY for loopback addresses — all other traffic
  remains HTTPS-only, so the app's privacy/security posture is unchanged.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>

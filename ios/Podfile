platform :ios, '17.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  # Read the Runner app's own development team so vendored binary framework pods (e.g.
  # ObjectBox's xcframework) can be signed with a real identity instead of "Don't Code Sign".
  runner_team = installer.pods_project.root_object.attributes.dig('TargetAttributes')&.values&.first&.dig('DevelopmentTeam')
  if runner_team.nil?
    runner_project_path = File.join(__dir__, 'Runner.xcodeproj', 'project.pbxproj')
    if File.exist?(runner_project_path)
      contents = File.read(runner_project_path)
      match = contents.match(/DEVELOPMENT_TEAM = (\w+);/)
      runner_team = match[1] if match
    end
  end

  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    is_resource_bundle = target.respond_to?(:product_type) && target.product_type == 'com.apple.product-type.bundle'
    target.build_configurations.each do |config|
      # Force CocoaPods to code-sign vendored/prebuilt binary frameworks (e.g. ObjectBox's
      # xcframework) with the app's own signing identity. Xcode 15+'s CoreDevice installer
      # strictly rejects embedded frameworks with no code signature at all — CocoaPods'
      # default "Don't Code Sign" setting for Pod targets no longer passes on real devices.
      # Resource bundle targets (privacy manifests, etc.) carry no executable code and must be
      # left alone — forcing a dev team/signing requirement on them breaks the build.
      unless is_resource_bundle
        config.build_settings['CODE_SIGNING_ALLOWED'] = 'YES'
        config.build_settings['CODE_SIGNING_REQUIRED'] = 'YES'
        config.build_settings['DEVELOPMENT_TEAM'] = runner_team if runner_team
      end

      # Ensure Flutter framework is discoverable by all pods (fixes 'Flutter/Flutter.h' not found)
      config.build_settings['FRAMEWORK_SEARCH_PATHS'] ||= ['$(inherited)']
      config.build_settings['FRAMEWORK_SEARCH_PATHS'] << '"$(PODS_ROOT)/../../Flutter"'
      config.build_settings['FRAMEWORK_SEARCH_PATHS'] << '"$(PODS_CONFIGURATION_BUILD_DIR)/Flutter"'

      # Fix "double-quoted include in framework header" errors from PromisesObjC and others
      config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'

      # Optimize Debug launch performance by disabling dSYMs and only compiling active architecture
      if config.name == 'Debug'
        config.build_settings['DEBUG_INFORMATION_FORMAT'] = 'dwarf'
        config.build_settings['ONLY_ACTIVE_ARCH'] = 'YES'
      end

      # Suppress deprecation and pointer type warnings for specific third-party pods
      if ['geolocator_apple', 'firebase_core', 'firebase_messaging'].include? target.name
        config.build_settings['GCC_WARN_ABOUT_DEPRECATED_FUNCTIONS'] = 'NO'
        config.build_settings['CLANG_WARN_DEPRECATED_OBJC_IMPLEMENTATIONS'] = 'NO'
        config.build_settings['WARNING_CFLAGS'] ||= []
        config.build_settings['WARNING_CFLAGS'] << '-Wno-incompatible-pointer-types'
      end
    end
  end
end

# ───────────────────────────────────────────────────────────
# Campus Navigation – Flutter .env
#
# Copy to `.env` (gitignored) and fill in. Used with:
#   flutter run --dart-define-from-file=.env
#
# GOOGLE_MAPS_API_KEY is read from TWO places off this one file:
#   1. Dart, via --dart-define-from-file above;
#   2. android/app/build.gradle.kts, which parses this file directly and
#      injects the key into the manifest's com.google.android.geo.API_KEY.
# So a plain `flutter run` (no --dart-define) still produces a keyed
# Android build, and the app resolves the key at runtime off the manifest.
#
# iOS reads its key from Info.plist's `GMSApiKey` (see ios/Runner). Set it
# via ios/Flutter/Secrets.xcconfig or the Xcode build settings — it is NOT
# read from this file.
#
# Without a key the Google Maps tab renders OpenStreetMap instead and
# labels itself as such; nothing crashes.
#
# NOTE: In debug mode, a bare `flutter run` works without this file because
#       env_config.dart has hardcoded development defaults.
# ───────────────────────────────────────────────────────────

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
GOOGLE_MAPS_API_KEY=your-maps-key
GOOGLE_ROUTES_API_KEY=your-server-google-routes-key
TFNSW_API_KEY=your-tfnsw-open-data-key
TFNSW_STOP_ID=10101403
ALLOWED_WEB_ORIGINS=http://localhost:3000,https://your-web-domain.com
APP_ENV=development

# ───────────────────────────────────────────────────────────
# Campus Navigation – Flutter .env
#
# Copy to `.env` (gitignored) and fill in. Used with:
#   flutter run --dart-define-from-file=.env
#
# Google Maps uses one restricted key per platform (Google Cloud Console):
#   GOOGLE_MAPS_IOS_API_KEY      iOS-apps restriction, bundle ID
#                                dev.leoalavi.campusnavigation
#   GOOGLE_MAPS_ANDROID_API_KEY  Android-apps restriction, package
#                                io.mqnavigation.mq_navigation + SHA-1
#   GOOGLE_MAPS_API_KEY          web build (HTTP-referrer key), and the
#                                fallback for either platform key if unset
# scripts/run.sh copies each key into its gitignored native file:
#   iOS     → ios/Flutter/Secrets.xcconfig → Info.plist `GMSApiKey`
#   Android → android/secrets.properties   → manifest geo.API_KEY
# android/app/build.gradle.kts also reads this file directly, so a plain
# `flutter run` still keys Android. iOS is keyed only via scripts/run.sh.
#
# Without a key the Google Maps tab renders OpenStreetMap instead and
# labels itself as such; nothing crashes.
#
# NOTE: In debug mode, a bare `flutter run` works without this file because
#       env_config.dart has hardcoded development defaults.
# ───────────────────────────────────────────────────────────

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
GOOGLE_MAPS_IOS_API_KEY=
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_ROUTES_API_KEY=your-server-google-routes-key
TFNSW_API_KEY=your-tfnsw-open-data-key
TFNSW_STOP_ID=10101403
ALLOWED_WEB_ORIGINS=http://localhost:3000,https://your-web-domain.com
APP_ENV=development
